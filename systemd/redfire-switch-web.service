[Unit]
Description=Redfire Switch Web Management Interface
Documentation=https://github.com/carrierone/redfire-switch
After=network-online.target redfire-switch.service
Wants=redfire-switch.service
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=/usr/bin/redfire-switch web-ui --bind 0.0.0.0:8080 --config /etc/redfire-switch/config.toml
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redfire-switch-web

# Security hardening
User=redfire-web
Group=redfire
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redfire-switch/web /var/log/redfire-switch
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateMounts=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Web interface capabilities
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=8192
LimitNPROC=1024
TasksMax=512
MemoryMax=512M
CPUQuota=100%

# Environment
Environment="RUST_LOG=info"
Environment="WEB_UI_ENABLED=1"
EnvironmentFile=-/etc/redfire-switch/web-environment

[Install]
WantedBy=multi-user.target