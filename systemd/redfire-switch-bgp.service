[Unit]
Description=Redfire Switch BGP Anycast Service
Documentation=https://github.com/carrierone/redfire-switch
After=network-online.target redfire-switch.service
Requires=redfire-switch.service
PartOf=redfire-switch.service
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStartPre=/usr/bin/redfire-switch bgp-anycast check-config
ExecStart=/usr/bin/redfire-switch bgp-anycast start --config /etc/redfire-switch/bgp-anycast.toml
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/usr/bin/redfire-switch bgp-anycast stop --graceful
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redfire-switch-bgp

# Security hardening (inherit from main service)
User=redfire
Group=redfire
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redfire-switch /var/log/redfire-switch /run/redfire-switch
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateMounts=true
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

# Additional capabilities for BGP operations
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN

# Resource limits
LimitNOFILE=32768
LimitNPROC=8192
TasksMax=2048
MemoryMax=2G
CPUQuota=200%

# Environment
Environment="RUST_LOG=info"
Environment="BGP_ANYCAST_ENABLED=1"
EnvironmentFile=-/etc/redfire-switch/bgp-environment

# Watchdog
WatchdogSec=30s

[Install]
WantedBy=redfire-switch.service