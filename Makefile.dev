# Development Makefile for Redfire Switch
# This provides easy commands for development and testing with SIPp

.PHONY: help build dev test clean docker-build docker-up docker-down sipp-test debug pcap logs

# Variables
DOCKER_COMPOSE = docker-compose -f docker-compose.dev.yml
CARGO = cargo
SIPP = sipp
TEST_DIR = tests
PCAP_DIR = pcaps
LOG_DIR = logs

# Colors for output
RED = \033[0;31m
GREEN = \033[0;32m
YELLOW = \033[1;33m
NC = \033[0m # No Color

help: ## Show this help message
	@echo "$(GREEN)Redfire Switch Development Commands$(NC)"
	@echo "===================================="
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "$(YELLOW)%-20s$(NC) %s\n", $$1, $$2}'

# === Build Commands ===

build: ## Build the switch in debug mode
	@echo "$(GREEN)Building Redfire Switch in debug mode...$(NC)"
	$(CARGO) build
	@echo "$(GREEN)✅ Build complete$(NC)"

build-release: ## Build the switch in release mode
	@echo "$(GREEN)Building Redfire Switch in release mode...$(NC)"
	$(CARGO) build --release
	@echo "$(GREEN)✅ Release build complete$(NC)"

clean: ## Clean build artifacts
	@echo "$(YELLOW)Cleaning build artifacts...$(NC)"
	$(CARGO) clean
	rm -rf $(PCAP_DIR)/*.pcap
	rm -rf $(LOG_DIR)/*.log
	rm -rf $(TEST_DIR)/sipp/logs/*
	rm -rf $(TEST_DIR)/results/*
	@echo "$(GREEN)✅ Clean complete$(NC)"

# === Docker Commands ===

docker-build: ## Build Docker containers
	@echo "$(GREEN)Building Docker containers...$(NC)"
	$(DOCKER_COMPOSE) build
	@echo "$(GREEN)✅ Docker build complete$(NC)"

docker-up: ## Start Docker environment
	@echo "$(GREEN)Starting Docker environment...$(NC)"
	$(DOCKER_COMPOSE) up -d redfire-switch sipp-uas
	@echo "$(GREEN)Waiting for services to start...$(NC)"
	@sleep 5
	@echo "$(GREEN)✅ Docker environment ready$(NC)"
	@echo "$(YELLOW)Services:$(NC)"
	@echo "  - Redfire Switch: localhost:5060"
	@echo "  - SIPp UAS: localhost:5061"
	@echo "  - Wireshark: http://localhost:3000"

docker-down: ## Stop Docker environment
	@echo "$(YELLOW)Stopping Docker environment...$(NC)"
	$(DOCKER_COMPOSE) down
	@echo "$(GREEN)✅ Docker environment stopped$(NC)"

docker-logs: ## Show Docker logs
	$(DOCKER_COMPOSE) logs -f

# === Test Commands ===

test: docker-up ## Run all SIPp tests
	@echo "$(GREEN)Running SIPp test suite...$(NC)"
	cd $(TEST_DIR) && ./run-tests.sh all
	@echo "$(GREEN)✅ Tests complete$(NC)"

test-options: ## Test OPTIONS ping
	@echo "$(GREEN)Testing OPTIONS ping...$(NC)"
	$(SIPP) -sn uac -r 1 -m 5 -sf $(TEST_DIR)/sipp/scenarios/options_ping.xml localhost:5060
	@echo "$(GREEN)✅ OPTIONS test complete$(NC)"

test-call: ## Test basic call flow
	@echo "$(GREEN)Testing basic call flow...$(NC)"
	$(SIPP) -sn uac -r 1 -m 1 -sf $(TEST_DIR)/sipp/scenarios/basic_call_uac.xml localhost:5060
	@echo "$(GREEN)✅ Call test complete$(NC)"

test-register: ## Test REGISTER flow
	@echo "$(GREEN)Testing REGISTER flow...$(NC)"
	$(SIPP) -sn uac -r 1 -m 1 -sf $(TEST_DIR)/sipp/scenarios/register_test.xml localhost:5060
	@echo "$(GREEN)✅ REGISTER test complete$(NC)"

test-stress: ## Run stress test
	@echo "$(YELLOW)⚠️  Running stress test (100 calls @ 10 cps)...$(NC)"
	$(SIPP) -sn uac -r 10 -m 100 -sf $(TEST_DIR)/sipp/scenarios/stress_test.xml localhost:5060
	@echo "$(GREEN)✅ Stress test complete$(NC)"

sipp-uac: ## Run SIPp UAC manually
	$(SIPP) -sn uac -r 1 -rp 1000 -m 1 localhost:5060

sipp-uas: ## Run SIPp UAS manually
	$(SIPP) -sn uas -p 5061

# === Debug Commands ===

debug: build ## Run switch in debug mode
	@echo "$(GREEN)Starting Redfire Switch in debug mode...$(NC)"
	@echo "$(YELLOW)Debug options enabled:$(NC)"
	@echo "  - Single call mode"
	@echo "  - Verbose logging"
	@echo "  - Message dumping"
	@echo "  - Call flow tracing"
	RUST_LOG=debug RUST_BACKTRACE=1 ./target/debug/redfire-switch --debug --verbose --config config-dev.json start

debug-gdb: build ## Run switch with GDB
	@echo "$(GREEN)Starting Redfire Switch with GDB...$(NC)"
	RUST_LOG=debug gdb ./target/debug/redfire-switch

debug-docker: ## Debug inside Docker container
	@echo "$(GREEN)Entering debug container...$(NC)"
	$(DOCKER_COMPOSE) exec redfire-switch bash

valgrind: build ## Run with valgrind for memory debugging
	@echo "$(GREEN)Running with valgrind...$(NC)"
	valgrind --leak-check=full --show-leak-kinds=all ./target/debug/redfire-switch --config config-dev.json start

# === Monitoring Commands ===

pcap: ## Capture packets
	@echo "$(GREEN)Starting packet capture on port 5060...$(NC)"
	@mkdir -p $(PCAP_DIR)
	tcpdump -i any -w $(PCAP_DIR)/capture_$$(date +%Y%m%d_%H%M%S).pcap port 5060

pcap-live: ## Live SIP packet monitoring
	@echo "$(GREEN)Monitoring SIP packets...$(NC)"
	tcpdump -i any -n -s 0 -A port 5060

tshark: ## Monitor SIP with tshark
	@echo "$(GREEN)Monitoring SIP with tshark...$(NC)"
	tshark -i any -f "port 5060" -Y sip -T fields -e frame.time -e ip.src -e ip.dst -e sip.Method -e sip.Status-Code

logs: ## Tail logs
	@echo "$(GREEN)Tailing logs...$(NC)"
	tail -f $(LOG_DIR)/*.log

wireshark: ## Open Wireshark web interface
	@echo "$(GREEN)Opening Wireshark web interface...$(NC)"
	@echo "$(YELLOW)URL: http://localhost:3000$(NC)"
	@command -v xdg-open >/dev/null 2>&1 && xdg-open http://localhost:3000 || open http://localhost:3000

# === Development Workflow Commands ===

dev: docker-up ## Start development environment
	@echo "$(GREEN)Development environment ready!$(NC)"
	@echo ""
	@echo "$(YELLOW)Quick commands:$(NC)"
	@echo "  make test          - Run all tests"
	@echo "  make test-call     - Test single call"
	@echo "  make debug         - Run in debug mode"
	@echo "  make pcap-live     - Monitor SIP traffic"
	@echo "  make logs          - Tail logs"
	@echo ""
	@echo "$(YELLOW)Services:$(NC)"
	@echo "  Redfire Switch: localhost:5060"
	@echo "  SIPp UAS:       localhost:5061"
	@echo "  Wireshark:      http://localhost:3000"

dev-cycle: clean build test ## Full development cycle
	@echo "$(GREEN)✅ Development cycle complete$(NC)"

ci: clean build test ## CI pipeline simulation
	@echo "$(GREEN)Running CI pipeline...$(NC)"
	@echo "$(GREEN)✅ CI pipeline passed$(NC)"

# === Utility Commands ===

check: ## Check compilation
	$(CARGO) check

fmt: ## Format code
	$(CARGO) fmt

clippy: ## Run clippy linter
	$(CARGO) clippy -- -D warnings

doc: ## Generate documentation
	$(CARGO) doc --open

install-deps: ## Install required dependencies
	@echo "$(GREEN)Installing dependencies...$(NC)"
	@command -v sipp >/dev/null 2>&1 || (echo "Installing SIPp..." && sudo apt-get install -y sipp)
	@command -v tcpdump >/dev/null 2>&1 || (echo "Installing tcpdump..." && sudo apt-get install -y tcpdump)
	@command -v tshark >/dev/null 2>&1 || (echo "Installing tshark..." && sudo apt-get install -y tshark)
	@command -v docker >/dev/null 2>&1 || (echo "$(RED)Docker not installed. Please install Docker manually.$(NC)")
	@echo "$(GREEN)✅ Dependencies installed$(NC)"

stats: ## Show code statistics
	@echo "$(GREEN)Code Statistics:$(NC)"
	@echo "Lines of code:"
	@find src -name "*.rs" | xargs wc -l | tail -1
	@echo ""
	@echo "Number of files:"
	@find src -name "*.rs" | wc -l
	@echo ""
	@echo "TODOs:"
	@grep -r "TODO" src --include="*.rs" | wc -l

# Default target
.DEFAULT_GOAL := help