# Environment variables for Anti-Fraud Monitoring
# Copy this file to .env and update with your values

# Database
DB_PASSWORD=SecurePassword123!

# Grafana
GRAFANA_PASSWORD=admin

# Storage paths
RECORDINGS_PATH=/var/lib/redfire/recordings

# Network
ANTIFRAUD_SUBNET=172.28.0.0/16

# Service URLs
VOSK_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-en-us-0.22-lgraph.zip

# Monitoring
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=7d

# Security
COMPLIANCE_OFFICER_EMAIL=compliance@example.com
LEGAL_BASIS=18_USC_2511_2_a_i