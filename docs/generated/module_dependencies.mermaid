graph TD
    %% Redfire Switch Architecture Overview - System Components
    
    %% Core Application
    main[Main Application]
    config[System Configuration]
    
    %% High-Level Subsystems
    sip_subsystem[SIP Protocol Stack]
    routing_subsystem[Call Routing Engine]  
    media_subsystem[Media Processing]
    api_subsystem[External APIs]
    cli_subsystem[Management Tools]
    
    %% Support Systems
    security[Security & Auth]
    monitoring[Monitoring & CDR]
    
    %% Dependencies
    main --> config
    main --> sip_subsystem
    main --> routing_subsystem
    main --> security
    main --> monitoring
    
    sip_subsystem --> media_subsystem
    routing_subsystem --> media_subsystem
    
    api_subsystem --> sip_subsystem
    api_subsystem --> routing_subsystem
    
    cli_subsystem --> sip_subsystem
    cli_subsystem --> routing_subsystem
    cli_subsystem --> monitoring
    
    security -.-> sip_subsystem
    security -.-> api_subsystem
    
    monitoring -.-> sip_subsystem
    monitoring -.-> media_subsystem
    
    %% Styling
    classDef coreModule fill:#e1f5fe,stroke:#01579b,stroke-width:3px
    classDef subsystemModule fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px
    classDef supportModule fill:#fff3e0,stroke:#e65100,stroke-width:2px
    
    class main,config coreModule
    class sip_subsystem,routing_subsystem,media_subsystem,api_subsystem,cli_subsystem subsystemModule
    class security,monitoring supportModule
